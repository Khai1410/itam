# This file is optional — docker-compose.yml already has working defaults for all of
# these (itam / changeme / admin / admin123). Copy this to .env and edit it for
# anything beyond a local trial.

POSTGRES_USER=itam
POSTGRES_PASSWORD=changeme
POSTGRES_DB=itam
POSTGRES_PORT=5432

JWT_SECRET=please-change-this-jwt-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

FRONTEND_PORT=8080

# Optional: auto-append this domain to any employee account typed without an "@"
# (e.g. "jdoe" -> "jdoe@example.com"). Leave blank to disable.
EMPLOYEE_EMAIL_DOMAIN=

# Optional: "Sign in with Microsoft" (Azure AD / Microsoft Entra ID SSO). Leave all
# three blank to disable — the button is hidden and password login keeps working.
# Setup: Azure Portal -> Microsoft Entra ID -> App registrations -> New registration.
#   - Redirect URI (Web): https://<your-domain>/api/auth/azure/callback
#     (use http://localhost:8080/... for a local trial; you can register several)
#   - API permissions: Microsoft Graph -> openid, profile, email (usually default)
#   - Certificates & secrets -> New client secret -> copy the VALUE (not the ID)
# First-time SSO sign-ins are auto-created as "viewer" — promote them to admin
# from the Accounts page (as the seeded local admin) if needed.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Branding shown in the sidebar/login screen and in the handover-confirmation
# email template (Employee Lookup page). All optional — sensible placeholders
# are used if left blank. To use your own logo, replace
# frontend/src/assets/orgLogo.js.
ORG_NAME=
SENDER_NAME=
SENDER_TITLE=
SENDER_ADDRESS=
SENDER_MOBILE=
SENDER_EMAIL=
SENDER_WEB=
