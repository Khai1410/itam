# This file is optional — docker-compose.yml already has working defaults for all of
# these (itam / changeme / admin / admin123). Copy this to .env and edit it for
# anything beyond a local trial.

POSTGRES_USER=itam
POSTGRES_PASSWORD=changeme
POSTGRES_DB=itam
POSTGRES_PORT=5432

JWT_SECRET=please-change-this-jwt-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

FRONTEND_PORT=8080

# Optional: auto-append this domain to any employee account typed without an "@"
# (e.g. "jdoe" -> "jdoe@example.com"). Leave blank to disable.
EMPLOYEE_EMAIL_DOMAIN=

# Branding shown in the sidebar/login screen and in the handover-confirmation
# email template (Employee Lookup page). All optional — sensible placeholders
# are used if left blank. To use your own logo, replace
# frontend/src/assets/orgLogo.js.
ORG_NAME=
SENDER_NAME=
SENDER_TITLE=
SENDER_ADDRESS=
SENDER_MOBILE=
SENDER_EMAIL=
SENDER_WEB=
